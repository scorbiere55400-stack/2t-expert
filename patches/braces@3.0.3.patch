diff --git a/lib/validate-depth.js b/lib/validate-depth.js
new file mode 100644
index 0000000000000000000000000000000000000000..3b23ee1bbf7d39ab8b45b11aa6c845996dcf0ff5
--- /dev/null
+++ b/lib/validate-depth.js
@@ -0,0 +1,22 @@
+'use strict';
+// Bound recursive AST walkers, including callers supplying an AST directly.
+module.exports = ast => {
+  const pending = [[ast, 0, false]];
+  const active = new Set();
+  let visited = 0;
+  while (pending.length) {
+    const [node, depth, leaving] = pending.pop();
+    if (!node || typeof node !== 'object') continue;
+    if (leaving) { active.delete(node); continue; }
+    if (depth > 128) throw new SyntaxError('Brace pattern nesting exceeds 128');
+    if (active.has(node)) throw new SyntaxError('Cyclic brace AST');
+    if (++visited > 100000) throw new SyntaxError('Brace AST exceeds node limit');
+    active.add(node);
+    pending.push([node, depth, true]);
+    if (Array.isArray(node.nodes)) {
+      for (let i = node.nodes.length - 1; i >= 0; i--) {
+        pending.push([node.nodes[i], depth + 1, false]);
+      }
+    }
+  }
+};
